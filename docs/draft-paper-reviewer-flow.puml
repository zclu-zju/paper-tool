@startuml
title draft-paper-reviewer System Execution Flow

start

:Stage 0 - review-requirement-collector;
:Scan submitted manuscript path for TeX source;
if (Submitted manuscript is TeX source?) then (yes)
  :Show complete parameter table with defaults\nincluding download policy, top-X,\nfigure/table deletion policy,\nreport materiality policy,\nand post-core latexdiff audit policy;
  if (All parameters confirmed?) then (yes)
    :Write 00_requirements.md\nSTATUS: READY;
  else (no)
    :Write 00_requirements.md\nSTATUS: NEEDS_USER_CONFIRMATION\nor NEEDS_USER_INPUT;
    :Ask user no more than 3 question blocks;
    stop
  endif
else (no)
  :Write 00_requirements.md\nSTATUS: UNSUPPORTED_INPUT;
  :Tell user draft-paper-reviewer requires\nTeX source folder or explicit .tex root;
  stop
endif

:Stage 1 - manuscript-ingestor;
:Write 01_manuscript_inventory.md,\n01_manuscript_claims.csv,\nand manuscript extraction artifacts;
:Extract formulas, notation, and symbols;\nwrite 01_formula_symbol_inventory.csv\nwith first-use and first-explanation status;

:Stage 2 - topic-scope-analyst;
:Write 02_topic_scope.md\nSTATUS: NEEDS_USER_CONFIRMATION;

:Stage 3 - user-scope-confirmation-gate;
:Ask user to confirm or correct topic,\nmethod family, comparison boundary,\ntarget community, and exclusions;
if (Topic scope USER_CONFIRMED?) then (yes)
  :Lock corrected topic scope if user changed it;
else (no)
  :Wait for user confirmation or correction;
  stop
endif

:Stage 4 - literature-discovery-scout;
:Search only after 00 READY\nand 02 USER_CONFIRMED;
:Group candidates by topic,\nrank by citation count per topic\nand overall, mark download priority;
:Write 03_literature_candidates.csv\nand 03_literature_discovery.md;
if (Literature discovery shortage,\nweak evidence, or scope problem?) then (yes)
  if (Scope review needed?) then (yes)
    :Loop back to Stage 3;
    detach
  else (no)
    :Repeat Stage 4 within iteration policy;
    detach
  endif
else (no)
endif

:Stage 5 - review-paper-artifact-collector;
if (Download policy?) then (DOWNLOAD_ALL)
  :Download/reuse all public artifacts\nfrom in-scope discovered papers;
elseif (TOP_CITED_PER_TOPIC)
  :Download/reuse top X public artifacts\nby citation rank inside each topic;
elseif (TOP_CITED_OVERALL)
  :Download/reuse top X public artifacts\nby overall citation rank;
elseif (REQUIRED_EVIDENCE_ONLY)
  :Download/reuse artifacts required\nfor novelty, field norms, writing,\nterminology, table/figure evidence;
else (DO_NOT_DOWNLOAD)
  :Reuse already local artifacts only\nand mark downstream convention evidence limited;
endif
:Write 04_paper_artifacts.csv\nand 04_paper_artifacts.md;
:Store papers under\nworkspace/draft_paper_review/literature/papers/;

:Stage 6 - downloaded-paper-convention-miner;
:Read downloaded/local paper artifacts;
:Mine section writing, terminology,\nformula/notation explanation,\nexperiment, table, figure,\nclaim-strength, and limitation conventions;
:Write 05_downloaded_paper_conventions.csv\nand 05_downloaded_paper_conventions.md;
if (Need more local artifacts?) then (yes)
  :Loop back to Stage 4 or Stage 5\nas specified by Stage 6;
  detach
else (no)
endif

:Stage 7 - figure-table-retention-gatekeeper;
:Inspect manuscript figures, tables,\nalgorithms, appendix evidence,\nand supported claims;
:Decide MUST_KEEP, revise, move,\nmerge, delete, needs user decision,\nor needs more evidence;
:Write 06_figure_table_retention_gate.csv\nand 06_figure_table_retention_gate.md;
if (Needs user decision?) then (yes)
  :Ask user and stop;
  stop
elseif (Needs more evidence?) then (yes)
  :Loop back to Stage 5 or Stage 6;
  detach
else (ready)
endif

:Stage 8 - evidence-map-builder;
:Write 07_evidence_map.csv\nand 07_evidence_map.md;
:Map claims, formulas, symbols, terms,\nwriting moves, local convention IDs,\nfigure/table gate IDs, claim strength guidance,\nand evidence boundaries;
if (Evidence map needs replenishment?) then (yes)
  :Loop back to Stage 4, Stage 5,\nStage 6, or Stage 7 as specified;
  detach
else (no)
endif

:Stage 9 - reviewer-panel-configurator;
:Write 08_reviewer_configuration.md;

:Stage 10 - evidence-reviewer-panel-coordinator;
:Run EIC, methodology, domain,\nperspective, and Devil's Advocate reviewers;
:Require evidence IDs and local artifact support\nfor major literature, style, terminology,\nformula-symbol, table, figure,\nor field-norm claims;
:Run report-materiality-gatekeeper\nfor each human-facing report candidate;
:Write material reviewer reports using fixed numbers\nand 14_panel_summary.md when material/needed;

:Stage 11 - specialist-diagnostic-panel-coordinator;
:Run novelty, terminology, term usage,\nformula-symbol first-use,\nfield style, professional precision,\nliterature positioning, argument coherence,\ncitation, and writing audits;
:Use downloaded-paper conventions\nfor common-practice judgments;
:Run report-materiality-gatekeeper\nfor each human-facing audit candidate;
:Write material specialist audits using fixed numbers\nand 24_specialist_summary.md when material/needed;

:Stage 12 - editorial-synthesizer-scorer;
:Synthesize existing material review/audit issues only;
:Separate unsupported result boundaries\nfrom actual contribution weakness;
:Write 25_editorial_decision.md;

:Stage 13 - revision-planner;
:Write 26_revision_plan.md;
:Require convention IDs for new/redesigned\nfigures, tables, structures, terminology,\nand retention-gate IDs for deletions/merges/moves;
:Require formula-symbol tasks when symbols\nare unnecessary at first occurrence,\nused before explanation, explained only later,\nunexplained, or ambiguously reused;
if (Revision requested or required\nand revision allowed?) then (yes)
  :Stage 14 - paired-revision-coordinator;
  :Copy original TeX source into\nworkspace/draft_paper_review/revision/tex/;
  while (Active revision scopes remain?) is (yes)
    :Select one fixed or issue-based scope;
    :Read matching convention IDs,\nretention-gate rows, and symbol IDs;
    :Run scope reviewer on copied TeX;
    if (Reviewer accepts scope?) then (yes)
      :Log acceptance round to 29_revision_ledger.jsonl;
    else (no)
      if (Needs user input?) then (yes)
        :Write 27_paired_revision_summary.md\nSTATUS: NEEDS_USER_DECISION;
        :Export current ledger workbook when possible;
        stop
      elseif (Needs more evidence?) then (yes)
        :Write 27_paired_revision_summary.md\nSTATUS: NEEDS_MORE_EVIDENCE;
        :Target Stage 4, Stage 5,\nStage 6, Stage 7, or Stage 8;
        detach
      elseif (Objective limitation or max rounds reached?) then (yes)
        :Record deferred issue or max-round result\naccording to requirements policy;
        :Log round to 29_revision_ledger.jsonl;
      else (needs revision)
        if (Edit changes formula/notation/symbols?) then (yes)
          :Fix duplicate/conflicting definitions\nand judge unexplained symbols\nagainst downloaded-paper conventions;
        endif
        if (Edit changes table/figure/evidence artifact?) then (yes)
          if (Retention/convention support exists?) then (yes)
            :Run paired scope reviser on copied TeX;
          else (no)
            :Stop scope with NEEDS_USER_DECISION\nor NEEDS_MORE_EVIDENCE;
            detach
          endif
        else (no)
          :Run paired scope reviser on copied TeX;
        endif
        :Log change record to 29_revision_ledger.jsonl;
        :Run the same scope reviewer again;
        :Log reviewer recheck to 29_revision_ledger.jsonl;
      endif
    endif
    :Update 29_revision_ledger.xlsx\nwith openpyxl ledger tool;
  endwhile (no)
  :Write 27_paired_revision_summary.md,\n28_revision_changes.md,\n29_revision_ledger.jsonl,\n29_revision_ledger.xlsx,\nand CSV fallback exports;
else (no)
  :Write 26_revision_plan.md\nSTATUS: NOT_REQUESTED;
endif

:Stage 15 - revision-verifier;
if (Revision was performed?) then (yes)
  :Verify revision tasks, paired scope acceptance,\nledger completeness, claim safety, citations,\nformula-symbol notation convention compliance,\nconvention IDs, retention-gate IDs,\nand optional TeX compile status;
  :Verify validated contributions were not\nunnecessarily weakened;
else (no)
  :Write 30_revision_verification.md\nSTATUS: NOT_REQUESTED;
endif
:Write 30_revision_verification.md;

:Stage 16 - evidence-review-integrity-reviewer;
:Check requirements, TeX ingestion,\nformula-symbol inventory,\ntopic confirmation, literature, downloads,\nconvention mining, figure/table gate,\nevidence map, material reports, synthesis,\nrevision artifacts, ledger, iteration policy,\nnumbering, and hard gates;
if (VERDICT: GO?) then (yes)
  :Stage 17 - ultimate-report-synthesizer;
  :Read numbered material reports\nand traceability artifacts;
  :Write 99_ultimate_summary.md\nwith agent conclusions, actions,\ndownloaded-paper lessons, figure/table decisions,\nvalidated strengths, risks,\nand recommended reading path;
  if (Confirmed latexdiff policy allows audit\nand revised TeX exists?) then (yes)
    :Run latexdiff_revision_audit.py\non original and revised TeX roots;
    :Flatten TeX input/include content\nfor structured change extraction;
    :Write diff/latexdiff.tex,\n100_latexdiff_changes.csv,\n100_latexdiff_extraction.md,\nand 100_latexdiff_extraction.tex;
    :Stage 18 - latexdiff-change-auditor;
    :Read latexdiff outputs,\nrevision plan, ledger,\nrevision verification,\nand numbered reports;
    :Write 101_change_rationale_audit.md\nand 101_change_rationale_audit.tex\nwith what changed, why,\nand whether recheck is needed;
    if (Questionable change needs recheck?) then (yes)
      :Route change IDs to the target stage\nor prior agent named by Stage 18;
      :Enter Loopback Mode when policy allows;
      detach
    else (no)
      stop
    endif
  else (no)
    stop
  endif
else (VERDICT: REJECT)
  :Read exactly one target stage and rejection reason;
  :Compute issue_signature;
  :Read 32_iteration_log.md and count same-issue retries;
  if (Global iteration cap reached?) then (yes)
    :Write final report\nSTOPPED_MAX_TOTAL_ITERATIONS;
    stop
  elseif (Same stage/problem cap reached?) then (yes)
    :Classify issue as OBJECTIVE_LIMITATION,\nEVIDENCE_EXHAUSTED, REVIEW_DISAGREEMENT,\nor PROCESS_DEFECT;
    if (Policy is ASK_USER?) then (yes)
      :Ask user whether to defer,\nprovide missing material, or stop;
      stop
    elseif (Policy is BLOCK?) then (yes)
      :Stop and report blocker;
      stop
    else (DEFER_AND_CONTINUE)
      :Append 33_deferred_issues.md\nand exclude issue from further loopback;
      :Continue downstream from affected stage;
      detach
    endif
  else (retry allowed)
    :Append retry record to 32_iteration_log.md;
    :Re-run target stage with rejection\nas high-priority constraint;
    :Re-run all downstream affected stages;
    :Return to Stage 16;
    detach
  endif
endif

@enduml
